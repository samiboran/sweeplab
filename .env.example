# SweepLab Bot — örnek ortam değişkenleri. Kopyalayıp `.env` olarak kaydedin,
# gerçek değerleri girin. `.env` dosyasını ASLA commit etmeyin / paylaşmayın.

# --- Faz (bkz. bot/README.md — phased_rollout) ---
# testnet_auto      -> Faz 1: Binance Futures TESTNET + tam otomatik emir (risksiz doğrulama)
# live_notify_only  -> Faz 2: gerçek hesap, SADECE Telegram bildirimi, emir açmaz
# live_auto         -> Faz 3: gerçek hesap + tam otomatik, küçük sermaye + günlük zarar limitiyle
BOT_PHASE=testnet_auto

# --- Binance API ---
# ÖNEMLİ: API key SADECE "Futures Trading" izniyle oluşturulmalı.
# "Withdrawal" (para çekme) izni KESİNLİKLE AÇILMAMALI.
# Testnet key'i https://testnet.binancefuture.com üzerinden alınır (gerçek hesaptan farklıdır).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Telegram ---
# @BotFather ile bot oluşturup token alın; chat_id'nizi @userinfobot ile öğrenebilirsiniz.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Semboller / zaman aralığı ---
BOT_SYMBOLS=BTCUSDT,ETHUSDT,AVAXUSDT,SOLUSDT
BOT_INTERVAL=5m
BINANCE_WS_BASE=wss://stream.binance.com:9443

# --- Strateji parametreleri ---
SWING_WINDOW=5
WICK_MIN_PCT=0.40
RR=2.0
STOP_BUFFER_PCT=0.0005

# --- Risk / güvenlik ---
LEVERAGE=10
RISK_PCT_PER_TRADE=2.0
DAILY_LOSS_LIMIT_PCT=20
MAX_CONCURRENT_POSITIONS=1

# --- Durum / kill switch dosyaları nerede tutulsun ---
BOT_STATE_DIR=bot_state
TELEGRAM_POLL_INTERVAL_SEC=3.0
